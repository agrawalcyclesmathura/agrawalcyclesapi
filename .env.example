# Application
NODE_ENV=development
PORT=4000
API_PREFIX=api
CORS_ORIGIN=http://localhost:3000

# Database (PostgreSQL)
DATABASE_URL="postgresql://pathway:pathway@localhost:5432/pathway?schema=public"

# Redis
REDIS_URL="redis://localhost:6379"

# Auth
JWT_ACCESS_SECRET=change-me-access-secret
JWT_ACCESS_TTL=900            # 15 minutes (seconds)
JWT_REFRESH_SECRET=change-me-refresh-secret
JWT_REFRESH_TTL=1209600       # 14 days (seconds)

# Admin authentication (Firebase)
# Admins sign in with Firebase; the backend verifies the ID token, then authorizes
# via EITHER of two sources (either one grants access):
#   1) ADMIN_EMAILS — comma-separated allowlist of admin emails (owner-controlled,
#      no Firestore rules needed). Simplest/guaranteed path + bootstrap mechanism.
#   2) Firestore `admins` collection — a doc keyed by UID or email with
#      approved:true (edited in the Firebase console). Requires rules that let a
#      signed-in user read their own doc.
ADMIN_EMAILS=
FIREBASE_PROJECT_ID=
# Firestore collection holding admin approvals (docs keyed by Firebase UID,
# fields: approved:boolean (or admin:boolean), role?:string). Default: admins
FIREBASE_ADMIN_COLLECTION=admins
# Role granted to an approved admin when the Firestore doc has no `role` field.
FIREBASE_DEFAULT_ADMIN_ROLE=super_admin
# OPTIONAL service-account key (Firebase console → Project settings → Service
# accounts) — not required for this flow. Leave blank.
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
# Local dev only: point at the Firebase emulators. Leave BLANK in production.
FIREBASE_AUTH_EMULATOR_HOST=
FIRESTORE_EMULATOR_HOST=

# Storage — media uploads
# Uploads are written to the local filesystem (UPLOAD_DIR) and served from
# `<MEDIA_PUBLIC_URL>/uploads/...`. In production, MEDIA_PUBLIC_URL MUST be set
# to the public origin that serves the API/uploads (e.g. https://api.agrawalcycles.com),
# otherwise stored image URLs default to http://localhost:4000 and break for users.
# In Docker, mount a volume at UPLOAD_DIR (see docker-compose `uploads` volume) so
# uploaded images survive container rebuilds/redeploys.
UPLOAD_DIR=/app/uploads
MEDIA_PUBLIC_URL=

# S3 / Cloudflare R2 — NOT yet wired into the media pipeline (local disk is used).
# These are placeholders for a future object-storage backend; leave blank for now.
S3_ENDPOINT=
S3_REGION=auto
S3_BUCKET=pathway-media
S3_ACCESS_KEY=
S3_SECRET_KEY=

# Payments
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Email
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM="Pathway <no-reply@pathway.com>"
RESEND_API_KEY=
